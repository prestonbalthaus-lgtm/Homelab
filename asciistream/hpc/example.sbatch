#!/usr/bin/env bash
# --------------------------------------------------------------------------
# asciistream Slurm job -- GENERATED by hpc/sbatch_gen.py (v1). Regenerate
# rather than editing by hand.
#
# HONESTY: this launch recipe has NEVER been executed on a real cluster --
# no Slurm, Apptainer or InfiniBand existed where it was written. The srun/
# PMIx/UCX wiring below is a best-informed draft; validate it on your
# system before trusting any numbers (see hpc/README.md).
#
# Submit with (Slurm opens the log below at job start, so the directory
# must exist BEFORE submission):
#   mkdir -p /scratch/asciistream/run1 && sbatch <this file>
# --------------------------------------------------------------------------
#SBATCH --job-name=chassis-6029U
#SBATCH --partition=compute
#SBATCH --nodes=4
#SBATCH --ntasks=192
#SBATCH --ntasks-per-node=48
# dual Platinum 8160: 24 cores/socket -- keep the per-node ranks
# split evenly across the two NUMA domains (no inline comments on #SBATCH
# lines: several Slurm versions reject them):
#SBATCH --ntasks-per-socket=24
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/asciistream/run1/%x-%j.out
#SBATCH --exclusive
# bind to the 48 physical cores only, skip the HT siblings:
#SBATCH --hint=nomultithread

set -euo pipefail

# Shared-filesystem paths -- every compute node must see all three.
SIF=/shared/apptainer/asciistream-hpc.sif
REPO_DIR=/shared/src/asciistream
OUT_DIR=/scratch/asciistream/run1

mkdir -p "$OUT_DIR"

# --- UCX / RDMA environment ------------------------------------------------
# OMPI_MCA_pml=ucx is the no-silent-fallback guard: if UCX cannot
# initialise on the MCX-456A fabric the job ABORTS instead of quietly
# degrading to TCP over the management network. Apptainer passes the host
# environment into the container by default (do NOT add --cleanenv here --
# these exports and Slurm's PMIx variables must reach the in-container MPI).
export UCX_NET_DEVICES=mlx5_0:1
export UCX_TLS=rc_x,sm,self
export OMPI_MCA_pml=ucx
export OMPI_MCA_osc=ucx

# --- container binds ---------------------------------------------------------
# Repo mounts read-only at /work (the solver only READS code+config); output
# directory mounts at /out and becomes the CWD, because chassis_cfd.py writes
# its VTU/PVTU series relative to the CWD. The IB device/config paths are
# bound explicitly so the script also works on sites that configure
# apptainer with contained /dev (default configs mount host /dev wholesale).
BIND_ARGS=( --bind "$REPO_DIR:/work:ro" --bind "$OUT_DIR:/out" )
for _d in /dev/infiniband /sys/class/infiniband /etc/libibverbs.d; do
    [[ -e "$_d" ]] && BIND_ARGS+=( --bind "$_d" )
done

# --- pre-flight: is RDMA actually visible in the container? ----------------
# One probe rank per node. ucx_info -d lists usable transports; no rc/dc
# transport means the job WOULD run, but over TCP -- exactly the silent
# failure this guard exists to catch. Skip with
# ASCIISTREAM_SKIP_FABRIC_CHECK=1 (e.g. deliberate single-node TCP test).
if [[ "${ASCIISTREAM_SKIP_FABRIC_CHECK:-0}" != 1 ]]; then
    if ! srun --ntasks="$SLURM_JOB_NUM_NODES" --ntasks-per-node=1 \
          apptainer exec "${BIND_ARGS[@]}" "$SIF" \
          bash -c 'ucx_info -d 2>/dev/null | grep -Eq "Transport: *(rc|dc)"'; then
        echo "[preflight] FAILED: UCX sees no RC/DC (RDMA) transport inside the" >&2
        echo "[preflight] container. Check ibv_devinfo on the nodes, the OFED stack" >&2
        echo "[preflight] and hpc/README.md; or set ASCIISTREAM_SKIP_FABRIC_CHECK=1." >&2
        exit 1
    fi
fi

# --- distributed solve -------------------------------------------------------
# srun (not mpirun) launches every rank and wires them together via PMIx;
# --cpu-bind=cores + block:block packs consecutive ranks socket by socket so
# DoF-neighbouring ranks share a NUMA domain (--ntasks-per-socket above keeps
# the split even). Headless on purpose: no --callback-port, no --viz-every,
# no TUI, no Qt -- VTU output in $OUT_DIR is the whole product.
srun --mpi=pmix --kill-on-bad-exit=1 \
     --cpu-bind=cores --distribution=block:block \
     apptainer exec "${BIND_ARGS[@]}" --pwd /out "$SIF" \
     python3 /work/chassis_cfd.py --worker \
              --config /work/server_configs.json \
              --profile 6029U \
              --mesh fine \
              --engine 3d \
              --sim-time 30 \
              --dt 0.002 \
              --fan-duty 0.8

echo "[job] solve finished; VTU output in $OUT_DIR"
ls -1 "$OUT_DIR"/*.pvtu >/dev/null 2>&1 && ls -1 "$OUT_DIR"/*.pvtu | tail -5 || true
