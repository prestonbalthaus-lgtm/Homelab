# --- simulation output (regenerated every run) --------------------------------
*.vtu
*.pvtu
*.h5
*.xdmf
cfd_report_*.txt

# --- mid-run visualization export (ring buffer + manifest, host viewer) -------
viz_step_*/
viz_manifest.json
viz_manifest.json.tmp
.asciistream_viewer_ready

# --- dolfinx JIT form cache + its options file (regenerated per run) ----------
# The cache lives under the work dir on purpose: the container is --rm, so a
# cache inside it would be discarded and every run would recompile.
.jit-cache/
dolfinx_jit_options.json
dolfinx_jit_options.json.tmp

# --- generated plots (chassis_fan_tool.py / plot_profile.py) -------------------
pq_curves.png
server_velocity_profile.png

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.venv-viewer/
.pytest_cache/

# --- local tool state ---------------------------------------------------------
.claude/settings.local.json
