# --- secrets and key material --------------------------------------------
# Nothing in this list should ever reach the repository. The CA key in
# particular is what mints certificates for the admin panel: anyone holding a
# copy can issue themselves one.
.env
.env.*
!env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.srl
secrets/

# --- build output ---------------------------------------------------------
build/
*.class
.jdk/

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- live data ------------------------------------------------------------
# Generated by the bridge at runtime; the checked-in example lives in
# deploy/topology.example.json.
/status.json
/topology.json

# --- editor and OS junk ---------------------------------------------------
.DS_Store
*.swp
*~
.idea/
.vscode/
