# Copy to .env and fill in, or export these in the systemd unit.
#
# .env is gitignored. Never commit a real token: anyone with it can read your
# whole LibreNMS install. If one does get committed, rotate it in LibreNMS
# rather than just deleting the line, because it stays in the git history.

# --- LibreNMS -------------------------------------------------------------
LIBRENMS_URL=https://librenms.internal.example
LIBRENMS_TOKEN=
LIBRENMS_TIMEOUT=5
# Set to 0 only if LibreNMS uses a certificate this host does not trust.
LIBRENMS_VERIFY_TLS=1

# --- NetFlow --------------------------------------------------------------
# Directory of nfcapd files. Leave empty to run without bandwidth data.
NETFLOW_DIR=/var/cache/nfdump
NETFLOW_NFDUMP=nfdump
NETFLOW_WINDOW_SECONDS=300
NETFLOW_TIMEOUT=15

# --- topology -------------------------------------------------------------
# Which LibreNMS device backs each node on the map.
NOC_DEVICE_MAP=core=asr1006x.example,edge=asr1002x.example,lab=vxr.example
# The address each node is peered on. Used to match BGP sessions and NetFlow
# records to a link.
NOC_NODE_IPS=core=10.0.0.1,edge=10.0.0.2,lab=10.0.0.3,inet=198.51.100.1
# Optional display overrides; without these the LibreNMS hostname is used.
NOC_NODE_NAMES=core=ASR 1006X,edge=ASR 1002X,lab=7206 VXR,inet=Internet
NOC_NODE_ROLES=core=core router,edge=edge router,lab=lab router,inet=upstream
NOC_LINKS=core-edge,edge-lab,lab-core,edge-inet

# --- service --------------------------------------------------------------
NOC_BIND=127.0.0.1
NOC_PORT=8090
NOC_CACHE_SECONDS=30
